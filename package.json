{
  "name": "nexa",
  "productName": "Nexa",
  "version": "0.1.0",
  "description": "Ein Chat für Coding-Agenten: Claude Code und Codex mit derselben Oberfläche, Projekten, Agents, Freigaben und Usage.",
  "author": "Connor Breuer",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/qzconnor/nexa.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "desktopName": "nexa.desktop",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:icons": "electron scripts/build-icons.mjs",
    "build:launcher": "node scripts/build-launcher.mjs",
    "build:win": "npm run build && npm run build:launcher && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "release:build": "npm run build && npm run build:launcher && electron-builder --win --publish never",
    "release:build:linux": "npm run build && electron-builder --linux --publish never",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "codex:protocol": "codex app-server generate-ts --out docs/codex-protocol"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/vue": "^1.72.0",
    "@semantic-release/exec": "^7.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@unovis/ts": "^1.8.1",
    "@unovis/vue": "^1.8.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "electron": "45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^11.12.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "semantic-release": "^25.0.9",
    "shadcn-vue": "^2.9.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "uqr": "^0.1.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "koffi": true,
    "electron-winstaller": true,
    "node-pty": true
  }
}
